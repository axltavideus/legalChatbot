# ============================================================
# LexIndo — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
DATABASE_URL=sqlite:///./lexindo.db

# --- JWT ---
SECRET_KEY=njfviudbre89w0wsoxbine9vomw
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Admin ---
# Users registering as Admin Korpus must supply this code
ADMIN_INVITE_CODE=ADMIN2025

# --- AI / LLM ---
# Set MOCK_LLM=true to run without a real API key (uses canned responses)
GEMINI_API_KEY=your-gemini-api-key-here
MOCK_LLM=true

# --- ChromaDB ---
CHROMA_PATH=./chroma_db

# --- Embeddings ---
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_MODEL=intfloat/multilingual-e5-base
SIMILARITY_THRESHOLD=0.45
RETRIEVAL_TOP_K=5

# --- CORS (comma-separated for multiple origins) ---
CORS_ORIGINS=["http://localhost:3000"]
